# Copy to .env (git-ignored) and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# Local MongoDB in development; the Atlas connection string in production
MONGODB_URI=mongodb://localhost:27017/slsea

# Absolute base for every URL the API returns (Location, next/previous links).
# Production: the API Gateway invoke URL, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
PUBLIC_BASE_URL=http://localhost:3000

# Token signing key — generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_MINUTES=60

# First ADMIN, created at start-up only when the users collection is empty
BOOTSTRAP_ADMIN_USERNAME=hq.admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=SLSEA Head Office Admin

# Production only: the same value API Gateway adds as X-Origin-Secret. Leave empty locally.
ORIGIN_SECRET=
